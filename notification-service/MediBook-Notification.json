{
  "info": {
    "name": "MediBook - Notification Service",
    "description": "Complete test suite for notification-service on http://localhost:8088. Real emails will be sent to your Gmail inbox.",
    "_postman_id": "medibook-notification-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "PHASE 1 — GET JWT TOKEN (auth-service)",
      "item": [
        {
          "name": "1. Admin Login → Get JWT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "http://localhost:8081/auth/login",
              "protocol": "http", "host": ["localhost"], "port": "8081",
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@medibook.com\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Admin login 200', () => pm.response.to.have.status(200));",
                "const token = pm.response.text().trim();",
                "pm.collectionVariables.set('adminToken', token);",
                "console.log('Admin token saved');"
              ]
            }
          }]
        },
        {
          "name": "2. Patient Login → Get JWT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "http://localhost:8081/auth/login",
              "protocol": "http", "host": ["localhost"], "port": "8081",
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul.patient@medibook.com\",\n  \"password\": \"patient123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Patient login 200', () => pm.response.to.have.status(200));",
                "const token = pm.response.text().trim();",
                "pm.collectionVariables.set('patientToken', token);",
                "console.log('Patient token saved');"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "PHASE 2 — SEND REAL EMAILS (notification-service)",
      "item": [
        {
          "name": "3. Send Appointment Booked Email (PROTECTED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": {
              "raw": "http://localhost:8088/notifications/appointment-booked",
              "protocol": "http", "host": ["localhost"], "port": "8088",
              "path": ["notifications", "appointment-booked"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"8\",\n  \"recipientEmail\": \"patelhimanshu609@gmail.com\",\n  \"appointmentId\": \"1\",\n  \"doctorName\": \"Dr. Himanshu Patel\",\n  \"date\": \"2026-04-25\",\n  \"time\": \"09:00 AM\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Notification created - 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('notificationId assigned', () => pm.expect(body.notificationId).to.be.a('number'));",
                "pm.test('type is APPOINTMENT_BOOKED', () => pm.expect(body.type).to.equal('APPOINTMENT_BOOKED'));",
                "pm.test('emailSent is true', () => pm.expect(body.emailSent).to.be.true);",
                "pm.test('isRead is false', () => pm.expect(body.isRead).to.be.false);",
                "pm.collectionVariables.set('notificationId1', body.notificationId);",
                "console.log('Check your Gmail inbox for Appointment Booked email!');"
              ]
            }
          }]
        },
