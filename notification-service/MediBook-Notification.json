    {
      "name": "PHASE 3 — NOTIFICATION MANAGEMENT",
      "item": [
        {
          "name": "9. Get All Notifications for User (PUBLIC)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8088/notifications/user/8",
              "protocol": "http", "host": ["localhost"], "port": "8088",
              "path": ["notifications", "user", "8"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Get all returns 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('Returns array', () => pm.expect(body).to.be.an('array'));",
                "pm.test('At least 5 notifications', () => pm.expect(body.length).to.be.at.least(5));"
              ]
            }
          }]
        },
        {
          "name": "10. Get Unread Notifications (PUBLIC)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8088/notifications/user/8/unread",
              "protocol": "http", "host": ["localhost"], "port": "8088",
              "path": ["notifications", "user", "8", "unread"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Get unread returns 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('All are unread', () => body.forEach(n => pm.expect(n.isRead).to.be.false));"
              ]
            }
          }]
        },
